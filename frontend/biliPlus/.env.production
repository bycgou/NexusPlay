# 生产环境配置
#
# 生产通过 nginx 同源部署：接口与 WebSocket 都走相对/同源地址，
# 因此 VITE_BASE_API 保持 /api、WebSocket 留空即可（自动使用同源 ws/wss）。
#
# 只有 SRS 与前端不在同一域名时才需要显式配置 VITE_OBS_RTMP / VITE_SRS_FLV_BASE。

VITE_BASE_API=/api
VITE_API_BASE_URL=/api

# 留空 = 使用当前站点同源（https 页面自动使用 wss）
VITE_WS_CHAT=
VITE_WS_LIVE=

# 直播推拉流：按实际 SRS 部署地址填写
VITE_OBS_RTMP=
VITE_SRS_FLV_BASE=
VITE_SRS_FLV_PROXY=/srs-live
