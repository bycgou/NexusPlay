# 开发环境配置
#
# 接口走 Vite 代理（见 vite.config.ts），因此这里只需要相对路径。
# 需要本地覆盖时复制 .env.local.template 为 .env.local，不要直接改本文件。

VITE_BASE_API=/api
VITE_API_BASE_URL=/api

# WebSocket：不配置则回退到当前站点同源
VITE_WS_CHAT=ws://localhost:8081/ws/chat
VITE_WS_LIVE=ws://localhost:8081/ws/live

# 直播推拉流
VITE_OBS_RTMP=rtmp://localhost:1935/live
VITE_SRS_FLV_BASE=http://localhost:8080/live
VITE_SRS_FLV_PROXY=/srs-live
