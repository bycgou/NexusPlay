# 本地环境变量覆盖模板
#
# 复制本文件为 .env.local 后填入真实值；.env.local 已被 git 忽略，不会入库。
# 完整可选字段见 .env.development / .env.production。

# 后端接口基础路径（开发环境使用 Vite 代理）
VITE_BASE_API=/api

# 私信 WebSocket；留空则回退到当前站点同源
VITE_WS_CHAT=ws://localhost:8081/ws/chat

# 直播房间 WebSocket
VITE_WS_LIVE=ws://localhost:8081/ws/live

# OBS 推流服务器与 SRS 拉流地址
VITE_OBS_RTMP=rtmp://localhost:1935/live
VITE_SRS_FLV_BASE=http://localhost:8080/live
