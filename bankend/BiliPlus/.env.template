# NexusPlay 后端环境变量配置
# 复制此文件为 .env 并填入真实值
# Linux/Mac: source .env
# Windows PowerShell: Get-Content .env | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }

# ==================== 数据库配置 ====================
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# ==================== 邮箱配置 ====================
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_email_authorization_code_here

# ==================== JWT 密钥（建议32位以上随机字符串）====================
JWT_ADMIN_SECRET=change_this_to_a_random_32_chars_string
JWT_PEOPLE_SECRET=change_this_to_another_random_32_chars_string

# ==================== 外部访问地址 ====================
EXTERNAL_URL=http://localhost:8081

# ==================== Redis 配置（如有密码）====================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
