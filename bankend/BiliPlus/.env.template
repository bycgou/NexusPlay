# BiliPlus 后端环境变量模板
#
# 用法：复制为 .env 放在 bankend/BiliPlus/ 根目录（与 pom.xml 同级），
# 项目已引入 spring-dotenv，启动时会自动加载 .env。
# 生产环境请改用系统环境变量或容器 secret 注入，不要提交 .env 到仓库。

# ---------- 服务 ----------
SERVER_PORT=8081
EXTERNAL_URL=http://localhost:8081

# 跨域允许来源，逗号分隔；生产必须改成真实前端域名
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=biliplus
DB_USERNAME=root
DB_PASSWORD=123456

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- JWT（生产必须改为高强度随机串，禁止使用示例值） ----------
JWT_ADMIN_SECRET=change-me-admin
JWT_PEOPLE_SECRET=change-me-people

# ---------- 邮件（注册邮箱验证码） ----------
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- 文件存储 ----------
# Windows 本地开发示例（注意结尾保留斜杠）
VIDEO_UPLOAD_PATH=D:/MyOSS/biliPlus/video-website/Videos/
VIDEO_TEMP_PATH=D:/MyOSS/biliPlus/video-website/temp/
IMAGE_UPLOAD_PATH=D:/MyOSS/biliPlus/video-website/Images/

# ---------- 直播（SRS） ----------
SRS_RTMP_HOST=localhost
SRS_RTMP_PORT=1935
SRS_FLV_BASE=http://localhost:8080/live
# 无 RTC 环境保持 false；连麦会返回 rtcAvailable=false 并提示环境不支持
SRS_RTC_ENABLED=false
LIVE_PK_DURATION_SEC=300

# ---------- 直播回放 ----------
# 无录制环境保持 false（下播不写回放记录）。开启后需给出录制文件点播地址模板，
# {streamKey} 会被替换为下播时的流密钥，例如
# LIVE_REPLAY_URL_TEMPLATE=http://localhost:8080/replay/{streamKey}.mp4
LIVE_REPLAY_ENABLED=false
LIVE_REPLAY_URL_TEMPLATE=
